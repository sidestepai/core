{
  "name": "@sidestep/core",
  "version": "2.3.2",
  "description": "Sidestep — a standalone TypeScript SDK for driving Xano infrastructure from code. Compiles typed Xano workspaces into importable JSON.",
  "keywords": [
    "sidestep",
    "xano",
    "sdk",
    "typescript",
    "codegen",
    "infrastructure-as-code"
  ],
  "homepage": "https://github.com/sidestepai/core#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sidestepai/core.git"
  },
  "bugs": {
    "url": "https://github.com/sidestepai/core/issues"
  },
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "sidestep": "./dist/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "manifest.json",
    "llms.txt",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "codegen": "tsx scripts/codegen.ts",
    "codegen:filters": "tsx scripts/codegen-filters.ts",
    "codegen:methods": "tsx scripts/codegen-field-methods.ts",
    "manifest": "tsx scripts/manifest.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "prepublishOnly": "npm run build",
    "release": "npm publish --access public",
    "release:beta": "npm version prerelease --preid=beta -m \"chore(release): %s\" && npm publish --tag beta --access public"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "openid-client": "^6.8.4",
    "proper-lockfile": "^4.1.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^20.0.0",
    "@types/proper-lockfile": "^4.1.4",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "esbuild": "^0.24.2",
    "eslint": "^9.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.22.4",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
