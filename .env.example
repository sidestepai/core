# Copy to `.env` (gitignored) and fill in for `sidestep validate`.
# Switch a cloud instance <-> local Docker by changing XANO_VALIDATE_INSTANCE only.

# Instance base URL the meta API is served from.
#   cloud:  https://your-instance.xano.io
#   local:  http://localhost:8080
XANO_VALIDATE_INSTANCE=

# Meta bearer token for that instance (kept out of git — never commit a real token).
XANO_VALIDATE_TOKEN=

# Optional: the PARENT workspace that each run's disposable environment is created
# under. Defaults to 1. Not a read target — `validate` reads back from the ephemeral
# environment it just deployed into, whose internal workspace id is always 1.
XANO_VALIDATE_WORKSPACE_ID=
